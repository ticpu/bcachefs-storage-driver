+// parseAuthScopes parses an authentication scope value, which per the distribution
+// token-auth spec is a space-separated list of scope strings. A cross-repo blob mount
+// makes the registry ask for a token covering both repositories, so a challenge
+// carrying more than one is normal rather than malformed.
+func parseAuthScopes(scopeStr string) ([]authScope, error) {
+	scopes := []authScope{}
+	for _, fragment := range strings.Fields(scopeStr) {
+		scope, err := parseAuthScope(fragment)
+		if err != nil {
+			return nil, err
+		}
+		scopes = append(scopes, *scope)
+	}
+	if len(scopes) == 0 {
+		return nil, fmt.Errorf("error parsing auth scope: '%s'", scopeStr)
+	}
+	return scopes, nil
+}
