+func TestParseAuthScopes(t *testing.T) {
+	for _, c := range []struct {
+		input    string
+		expected []authScope // nil if a parse failure is expected
+	}{
+		{
+			input:    "repository:group/dest:pull,push",
+			expected: []authScope{{resourceType: "repository", remoteName: "group/dest", actions: "pull,push"}},
+		},
+		{
+			// A cross-repo blob mount asks for both repositories at once.
+			input: "repository:group/dest:pull,push repository:other/src:pull",
+			expected: []authScope{
+				{resourceType: "repository", remoteName: "group/dest", actions: "pull,push"},
+				{resourceType: "repository", remoteName: "other/src", actions: "pull"},
+			},
+		},
+		{
+			input:    "registry:catalog:*",
+			expected: []authScope{{resourceType: "registry", remoteName: "catalog", actions: "*"}},
+		},
+		{input: "", expected: nil},
+		{input: "foo:bar", expected: nil},
+		{input: "repository:group/dest:pull,push foo:bar", expected: nil},
+	} {
+		scopes, err := parseAuthScopes(c.input)
+		if c.expected == nil {
+			assert.Error(t, err, c.input)
+		} else {
+			require.NoError(t, err, c.input)
+			assert.Equal(t, c.expected, scopes, c.input)
+		}
+	}
